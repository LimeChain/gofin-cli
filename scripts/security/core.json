[
  {
    "id": "native-authority",
    "package": "gofin-authorization",
    "target": [
      "--lib"
    ],
    "reason": "Reject replay, changed financial intent, expired challenges, forged helper evidence and unsafe native trust paths.",
    "tests": [
      "review_action_must_match_the_challenge_purpose",
      "every_financial_purpose_requires_a_valid_typed_review",
      "sudo_review_cannot_create_financial_authority",
      "rejects_replay_or_changed_payload_or_expiry",
      "checks_millisecond_deadlines_and_authentication_time",
      "unavailable_malformed_or_declined_never_authorizes",
      "malformed_challenges_are_not_displayed_or_approved",
      "unsupported_provider_fails_closed",
      "writable_or_symlinked_store_path_fails_closed",
      "installed_path_name_cannot_substitute_for_hardened_code_flags"
    ]
  },
  {
    "id": "credentials",
    "package": "gofin-credentials",
    "target": [
      "--lib"
    ],
    "reason": "Reject secret disclosure, path injection, unsafe files and partial credential writes.",
    "tests": [
