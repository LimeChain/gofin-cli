      "malformed_coingecko_keys_and_plans_fail_without_echoing_secrets",
      "debug_and_bad_input_errors_never_echo_secret_values",
      "references_are_opaque_canonical_non_paths",
      "unknown_secret_fields_are_rejected",
      "synthetic_store_files_use_new_private_regular_files",
      "oversize_synthetic_material_leaves_no_partial_file"
    ]
  },
  {
    "id": "human-terminal",
    "package": "gofin-human-terminal",
    "target": [
      "--lib"
    ],
