[
  {
    "id": "exchange-binance-funding",
    "package": "gofin-binance",
    "target": [
      "--test",
      "futures_funding"
    ],
    "reason": "Reject ambiguous transfer history and replay after uncertain writes.",
    "tests": [
      "missing_duplicate_mismatched_and_incomplete_history_never_settle_or_replay",
      "self_transfer_response_loss_stays_unknown_after_restart_without_guessing_or_replay"
    ]
  },
  {
    "id": "exchange-binance-authority",
    "package": "gofin-binance",
    "target": [
      "--test",
      "valuation_revalidation"
    ],
    "reason": "Reject drift in financial limits before dispatch.",
    "tests": [
      "engine_rejects_final_quote_movement_before_any_binance_post",
      "stale_zero_and_unavailable_quotes_fail_closed_during_prepare"
    ]
  },
  {
    "id": "exchange-coinbase-withdrawal",
    "package": "gofin-coinbase",
    "target": [
      "--test",
      "withdrawal"
    ],
    "reason": "Reject forged or cross-network withdrawal evidence and changed balances.",
    "tests": [
      "all_networks_recover_original_unknown_submission_and_reject_cross_network_receipts",
      "all_routes_reject_wrong_contract_without_dispatch",
      "fractional_balance_drop_after_prepare_is_rejected_before_dispatch"
    ]
  },
  {
    "id": "exchange-coinbase-orders",
    "package": "gofin-coinbase",
    "target": [
      "--test",
      "institutional_orders"
    ],
    "reason": "Reject competing order identity and truncated or unrelated evidence.",
    "tests": [
      "exchange_reconciliation_stays_unknown_when_another_record_claims_client_id",
      "exchange_fill_cursor_repetition_is_unknown_instead_of_certifying_a_truncated_page",
      "exchange_reconciliation_rejects_a_wrong_authoritative_product_before_fills"
    ]
  },
  {
    "id": "exchange-kraken-futures",
    "package": "gofin-kraken",
    "target": [
      "--lib"
    ],
    "reason": "Reject unsupported margin authority and reconcile unknown submissions without replay.",
    "tests": [
      "derivative_response_loss_recovers_after_restart_without_replay",
      "authoritative_available_margin_and_isolated_leverage_reject_before_dispatch",
      "derivative_cash_mismatch_keeps_proof_unsettled"
    ]
  },
  {
    "id": "exchange-hyperliquid-account",
    "package": "gofin-hyperliquid",
    "target": [
      "--test",
      "account_lifecycle"
    ],
    "reason": "Require exact nonce and withdrawal receipt proof after uncertain dispatch.",
    "tests": [
      "class_transfer_response_loss_without_nonce_receipt_stays_unknown",
      "unrecognized_or_malformed_native_class_transfer_error_stays_unknown",
      "withdrawal_recipient_mismatch_stays_unknown_without_replay"
    ]
  },
  {
    "id": "exchange-hyperliquid-fills",
    "package": "gofin-hyperliquid",
    "target": [
      "--lib"
    ],
    "reason": "Reject conflicting identities, unauthorised fill bounds, and spoofed native receipts.",
    "tests": [
      "conflicting_identity_and_approved_bounds_fail_closed",
      "matching_receipts_require_exact_identity_time_side_and_native_market"
    ]
  },
  {
    "id": "exchange-transport",
    "package": "gofin-exchange",
    "target": [
      "--lib",
      "--features",
      "binance,kraken,coinbase"
    ],
    "reason": "Prevent replay of uncertain writes, secret disclosure and dispatch after authority revocation.",
    "tests": [
      "timeout_write_never_replays",
      "redirects_never_replay_write",
      "rejected_dispatch_guard_stops_before_network_and_auth_debug_is_redacted",
      "revoked_during_signing_is_rejected_before_http_send"
    ]
  }
]
