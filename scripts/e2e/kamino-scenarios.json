{
  "scenarios": [
    {
      "id": "kamino-lending-vault",
      "group": "solana",
      "environment": "surfpool",
      "description": "Synthetic Kamino lending vault deposit and full withdrawal through the public CLI with finalized receipt and native approval checks.",
      "requires": [
        "surfpool",
        "solana",
        "solana-keygen",
        "cargo"
      ],
      "env": {
        "GOFIN_DEV_BUILD_ID": "synthetic-kamino-build",
        "GOFIN_OUTCOME_EVIDENCE": "{artifacts}/kamino-lending-vault-evidence.json"
      },
      "prepare": [
        [
          "cargo",
          "build",
          "--locked",
          "-p",
          "gofin-cli",
          "--example",
          "gofin-dev"
        ],
        [
          "cp",
          "{repo}/target/debug/examples/gofin-dev",
          "{artifacts}/kamino-lending-cli"
        ]
      ],
      "run": [
        [
          "{python}",
          "{repo}/scripts/e2e/kamino-surfpool.py",
          "lending",
          "--cli",
          "{artifacts}/kamino-lending-cli",
          "--summary",
          "{artifacts}/kamino-lending-summary.json"
        ]
      ],
      "evidence": "{artifacts}/kamino-lending-vault-evidence.json"
    },
    {
      "id": "kamino-liquidity-vault",
