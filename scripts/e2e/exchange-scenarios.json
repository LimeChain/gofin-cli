  {
    "id": "coinbase-exchange-orders",
    "group": "exchange",
    "environment": "mock",
    "description": "Coinbase Exchange funded portfolio: buy, partial sale, resting sale and cancel, then sell remainder",
    "requires": [
      "cargo"
    ],
    "env": {
      "GOFIN_DEV_BUILD_ID": "synthetic-coinbase-build",
      "GOFIN_COINBASE_PLAN_CLI": "{artifacts}/coinbase-exchange-cli"
    },
    "prepare": [
      [
        "cargo",
        "build",
        "--locked",
        "-p",
        "gofin-cli",
        "--example",
        "gofin-dev"
      ],
      [
        "cp",
        "{repo}/target/debug/examples/gofin-dev",
        "{artifacts}/coinbase-exchange-cli"
      ]
    ],
    "run": [
      {
        "argv": [
          "cargo",
          "test",
          "--locked",
          "-p",
          "gofin-broker",
          "--test",
          "coinbase_plan_workflow",
          "positive_coinbase_exchange_order_lifecycle_via_cli",
          "--",
          "--ignored",
          "--exact"
        ],
        "expected_tests": 1
      }
    ]
  },
