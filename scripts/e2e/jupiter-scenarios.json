[
  {
    "id": "jupiter-jlp",
    "group": "solana",
    "environment": "surfpool",
    "description": "Mint JLP, observe the resulting balance and redeem it through the public CLI on an owned Surfpool fork with cloned Jupiter program and locally refreshed oracle timestamps.",
    "requires": [
      "surfpool",
      "solana",
      "solana-keygen",
      "cargo",
      "make"
    ],
    "env": {
      "GOFIN_OUTCOME_EVIDENCE": "{artifacts}/jupiter-jlp-outcome.json"
    },
    "prepare": [
      [
        "cargo",
        "fetch",
        "--locked"
      ]
    ],
    "run": [
      [
        "{python}",
        "{repo}/scripts/e2e/jupiter-jlp-validator.py",
        "--summary",
        "{artifacts}/jupiter-jlp-summary.json"
      ]
    ],
    "evidence": "{artifacts}/jupiter-jlp-outcome.json"
  },
  {
    "id": "jupiter-perpetuals",
    "group": "solana",
    "environment": "mock",
    "description": "Open and close long and short, add and remove collateral, and cancel a resting order through the public CLI with a stateful synthetic Solana and keeper backend.",
    "requires": [
      "cargo"
    ],
    "env": {
      "GOFIN_OUTCOME_EVIDENCE": "{artifacts}/jupiter-perpetuals-outcome.json"
    },
    "prepare": [
      [
        "cargo",
        "fetch",
        "--locked"
      ]
    ],
    "run": [
      [
        "{python}",
        "{repo}/scripts/e2e/jupiter-perps-mock.py",
        "--summary",
        "{artifacts}/jupiter-perps-summary.json"
      ]
    ],
    "evidence": "{artifacts}/jupiter-perpetuals-outcome.json"
  },
  {
    "id": "jupiter-quote-expiry-cli",
    "group": "solana",
    "environment": "mock",
    "description": "Public CLI refreshes an expired Jupiter quote under one native approval; a refreshed quote below the approved floor dispatches nothing. Controlled provider transport, no live writes.",
    "requires": [
      "cargo"
    ],
    "env": {
      "GOFIN_DEV_BUILD_ID": "synthetic-jupiter-refresh-build",
      "GOFIN_JUPITER_REFRESH_CLI": "{artifacts}/jupiter-refresh-cli",
      "GOFIN_OUTCOME_EVIDENCE": "{artifacts}/jupiter-quote-expiry-cli-outcome.json"
    },
    "prepare": [
      [
        "cargo",
        "build",
        "--locked",
        "-p",
        "gofin-cli",
        "--example",
        "gofin-dev"
      ],
      [
        "cp",
        "{repo}/target/debug/examples/gofin-dev",
        "{artifacts}/jupiter-refresh-cli"
      ]
    ],
    "run": [
      [
        "cargo",
        "test",
        "--locked",
        "-p",
        "gofin-broker",
        "--example",
        "gofin-dev-broker",
        "expired_jupiter_quote",
        "--",
        "--nocapture"
      ],
      [
        "{python}",
        "{repo}/scripts/e2e/jupiter-expiry-evidence.py"
      ]
    ],
    "expected_tests": 2,
    "evidence": "{artifacts}/jupiter-quote-expiry-cli-outcome.json"
  }
]
