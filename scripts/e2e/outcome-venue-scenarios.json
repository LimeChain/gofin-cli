    "description": "Kraken correlated refund is proven; Binance and Hyperliquid remain unconfirmed where supported observations lack refund evidence. Same- and different-account probes continue. Coinbase refund proof is waived by user.",
    "requires": [
      "cargo"
    ],
    "env": {
      "GOFIN_DEV_BUILD_ID": "synthetic-kraken-build",
      "GOFIN_KRAKEN_PLAN_CLI": "{artifacts}/kraken-outcome-cli"
    },
    "evidence": "{artifacts}/outcome.a15.json",
    "prepare": [
      [
        "cargo",
        "build",
        "--locked",
        "-p",
        "gofin-cli",
        "--example",
        "gofin-dev"
      ],
      [
        "cp",
        "{repo}/target/debug/examples/gofin-dev",
        "{artifacts}/kraken-outcome-cli"
      ]
    ],
    "run": [
      {
        "argv": [
          "env",
          "GOFIN_OUTCOME_EVIDENCE={artifacts}/outcome.a15.kraken.json",
          "cargo",
          "test",
          "--locked",
          "-p",
          "gofin-broker",
          "--test",
          "kraken_plan_workflow",
          "--quiet",
          "failed_kraken_withdrawal_waits_for_correlated_refund_without_blocking_other_actions",
          "--",
          "--ignored"
        ],
        "expected_tests": 1
      },
      {
        "argv": [
          "env",
          "GOFIN_OUTCOME_EVIDENCE={artifacts}/outcome.a15.binance.unconfirmed.json",
          "cargo",
          "test",
          "--locked",
          "-p",
          "gofin-broker",
          "--test",
          "binance_roundtrip",
          "--quiet",
          "failed_withdrawal_remains_unresolved_without_correlated_refund_and_does_not_block_other_actions",
          "--",
          "--include-ignored"
        ],
        "expected_tests": 1
      },
      {
        "argv": [
          "env",
          "GOFIN_OUTCOME_EVIDENCE={artifacts}/outcome.a15.hyperliquid.unconfirmed.json",
          "cargo",
          "test",
          "--locked",
          "-p",
          "gofin-broker",
          "--test",
          "hyperliquid_positive_workflow",
          "--quiet",
          "hyperliquid_withdrawal_without_correlated_ledger_stays_unconfirmed",
          "--",
          "--include-ignored"
        ],
        "expected_tests": 1
      },
      [
        "{python}",
        "{repo}/scripts/e2e/aggregate-outcome-evidence.py",
        "outcome.a15",
        "{artifacts}/outcome.a15.json",
        "{artifacts}/outcome.a15.kraken.json",
        "{artifacts}/outcome.a15.binance.unconfirmed.json",
        "{artifacts}/outcome.a15.hyperliquid.unconfirmed.json"
      ]
    ]
  }
]
