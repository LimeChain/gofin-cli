# Disposable development credentials only. Copy to .env.gofin-dev and fill in
# at least one complete account. Import reads this file as data, never shell code.
# These credentials are intentionally accessible to the developing agent.
# Do not use production keys. Never commit the filled-in file.

# Binance HMAC account. UID is the public account identity shown by Binance;
# GoFin checks it with the venue before account operations.
# GOFIN_DEV_BINANCE_API_KEY=replace-with-development-api-key
# GOFIN_DEV_BINANCE_SECRET=replace-with-development-hmac-secret
# GOFIN_DEV_BINANCE_UID=replace-with-numeric-account-uid

# EVM wallet. The address is derived from the key, so no address is needed.
# GOFIN_DEV_EVM_PRIVATE_KEY=replace-with-development-private-key

# Solana wallet. The address is derived from the key.
# Import only this provider from a mixed file with:
# make dev-env-import DEV_IMPORT_FLAGS='--provider solana' DEV_CREDENTIALS_FILE=/absolute/path/.env.gofin-dev
# GOFIN_DEV_SOLANA_PRIVATE_KEY=replace-with-disposable-development-keypair
# Existing files may use this alias instead:
# SOLANA_PRIVATE_KEY=replace-with-disposable-development-keypair

# Optional second wallet for return-path/transfer tests.
# GOFIN_DEV_EVM_SECONDARY_PRIVATE_KEY=replace-with-second-development-private-key

# Instead of HMAC SECRET, use GOFIN_DEV_BINANCE_PRIVATE_KEY_PEM for RSA/Ed25519.
# Keep PEM on one line with literal \n separators (quoted or unquoted).
# Existing aliases are accepted without renaming:
# BINANCE_MASTER_ACCOUNT_API_KEY=replace-with-development-api-key
# BINANCE_MASTER_ACCOUNT_API_PEM=replace-with-development-pem
# BINANCE_SUB_ACCOUNT_API_KEY=replace-with-development-subaccount-api-key
# BINANCE_SUB_ACCOUNT_API_PEM=replace-with-development-subaccount-pem
# BINANCE_SUB_ACCOUNT_EMAIL=replace-with-subaccount-email
# ETH_WALLET_PK=replace-with-development-wallet-private-key
# Do not specify an alias and its canonical key together.

# Optional subaccount (requires the master above):
# GOFIN_DEV_BINANCE_SUB_API_KEY=replace-with-development-api-key
# GOFIN_DEV_BINANCE_SUB_SECRET=replace-with-development-hmac-secret
# Or use GOFIN_DEV_BINANCE_SUB_PRIVATE_KEY_PEM instead of SUB_SECRET.
# GOFIN_DEV_BINANCE_SUB_UID=replace-with-numeric-subaccount-uid
# GOFIN_DEV_BINANCE_SUB_EMAIL=replace-with-subaccount-email

# For offline import, supply both configured Binance UIDs and subaccount email.
# To discover UIDs with authenticated read-only calls, add this Make argument:
# DEV_IMPORT_FLAGS=--discover-identities
# If Binance omits the UID/email association, supply SUB_EMAIL yourself.

# Kraken Spot/Margin and Derivatives use distinct API credentials. API-level 2FA
# keys are unsupported. Account IDs are public, human-confirmed offline metadata.
# GOFIN_DEV_KRAKEN_API_KEY=replace-with-disposable-spot-api-key
# GOFIN_DEV_KRAKEN_SECRET=replace-with-base64-spot-secret
# GOFIN_DEV_KRAKEN_ACCOUNT_ID=replace-with-public-account-id
# Optional human-selected Spot default alias; authenticated ownership is checked on use.
# Kraken does not identify the default wallet; never infer it from type or balance.
# GOFIN_DEV_KRAKEN_DEFAULT_WALLET_ACCOUNT_ID=replace-with-exact-owned-wallet-id
# GOFIN_DEV_KRAKENFUTURES_API_KEY=replace-with-disposable-derivatives-api-key
# GOFIN_DEV_KRAKENFUTURES_SECRET=replace-with-base64-derivatives-secret
# GOFIN_DEV_KRAKENFUTURES_ACCOUNT_ID=replace-with-public-derivatives-account-id

# Coinbase App / Advanced Trade uses an explicit CDP credential type. Use either
# the ECDSA PEM key (recommended for REST client compatibility) or the CDP
# Ed25519 base64 64-byte seed+public key. Import verifies portfolio identity
# and granted permissions with read-only authenticated calls.
# GOFIN_DEV_COINBASE_API_KEY=organizations/<org>/apiKeys/<key-id>
# GOFIN_DEV_COINBASE_CREDENTIAL_TYPE=ecdsa
# GOFIN_DEV_COINBASE_PRIVATE_KEY_PEM=replace-with-p256-pkcs8-or-sec1-pem
# For explicit Ed25519 use the alternative pair:
# GOFIN_DEV_COINBASE_CREDENTIAL_TYPE=ed25519
# GOFIN_DEV_COINBASE_SECRET=replace-with-base64-ed25519-64-byte-key
# Optional exact portfolio selector when the credential exposes more than one.
# GOFIN_DEV_COINBASE_PORTFOLIO_ID=replace-with-permissioned-portfolio-uuid
# GOFIN_DEV_COINBASE_NAME=dev-coinbase

# Coinbase Exchange and International use separate HMAC keys/passphrases.
# GOFIN_DEV_COINBASEEXCHANGE_API_KEY=replace-with-key
# GOFIN_DEV_COINBASEEXCHANGE_SECRET=replace-with-base64-hmac-secret
# GOFIN_DEV_COINBASEEXCHANGE_PASSPHRASE=replace-with-api-passphrase
# GOFIN_DEV_COINBASEINTERNATIONAL_API_KEY=replace-with-key
# GOFIN_DEV_COINBASEINTERNATIONAL_SECRET=replace-with-base64-hmac-secret
# GOFIN_DEV_COINBASEINTERNATIONAL_PASSPHRASE=replace-with-api-passphrase

# Optional additional Kraken connections for master/child account scenarios.
# Each product supports indexed groups 1..8; groups are independent and bounded.
# API_KEY, SECRET and ACCOUNT_ID are required together. NAME is optional and
# defaults to dev-kraken-N or dev-krakenfutures-N. Existing slot identities,
# names and selected default-wallet aliases cannot be changed by reimport.
# Omitted groups remain available; a subset file can rotate one same-account key.
# Do not import the same product/account ID in both legacy and indexed groups.
# GOFIN_DEV_KRAKEN_1_API_KEY=replace-with-disposable-spot-api-key
# GOFIN_DEV_KRAKEN_1_SECRET=replace-with-base64-spot-secret
# GOFIN_DEV_KRAKEN_1_ACCOUNT_ID=replace-with-public-spot-account-id-without-spaces
# GOFIN_DEV_KRAKEN_1_NAME=spot-test
# GOFIN_DEV_KRAKEN_1_DEFAULT_WALLET_ACCOUNT_ID=replace-with-exact-owned-wallet-id
# GOFIN_DEV_KRAKENFUTURES_1_API_KEY=replace-with-disposable-master-futures-key
# GOFIN_DEV_KRAKENFUTURES_1_SECRET=replace-with-base64-master-futures-secret
# GOFIN_DEV_KRAKENFUTURES_1_ACCOUNT_ID=replace-with-public-master-account-uid
# GOFIN_DEV_KRAKENFUTURES_1_NAME=futures-master-test
# GOFIN_DEV_KRAKENFUTURES_2_API_KEY=replace-with-disposable-child-futures-key
# GOFIN_DEV_KRAKENFUTURES_2_SECRET=replace-with-base64-child-futures-secret
# GOFIN_DEV_KRAKENFUTURES_2_ACCOUNT_ID=replace-with-public-child-account-uid
# GOFIN_DEV_KRAKENFUTURES_2_NAME=futures-child-test
